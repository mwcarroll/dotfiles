{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "background": "#282a36",
    "comment": "#6272a4",
    "currentLine": "#44475a",
    "cyan": "#8be9fd",
    "foreground": "#f8f8f2",
    "green": "#50fa7b",
    "orange": "#ffb86c",
    "pink": "#ff79c6",
    "purple": "#bd93f9",
    "red": "#ff5555",
    "yellow": "#f1fa8c"
  },
  "secondary_prompt": {
    "template": "❯❯ ",
    "foreground": "p:currentLine",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "❯ ",
    "foreground": "p:currentLine",
    "background": "transparent"
  },
  "console_title_template": "{{.Folder}} :: {{.UserName}}@{{.HostName}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}}",
          "foreground": "p:foreground",
          "background": "p:background",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \ue0b1",
          "foreground": "p:currentLine",
          "background": "p:background",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "full"
          },
          "trailing_diamond": "\ue0b0",
          "template": "{{ if (matchP \"~\" .Path) }} \ueb06 {{ else }} \uf115 {{end}}{{ .Path }} ",
          "foreground": "p:cyan",
          "background": "p:background",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_upstream_icon": true,
            "git_icon": "\uf1d2",
            "github_icon": "\uf09b"
          },
          "template": " {{ url (print \"at \" .UpstreamIcon) .UpstreamURL }} ",
          "foreground": "p:background",
          "background": "p:comment",
          "type": "git",
          "style": "diamond"
        },
        {
          "properties": {
            "branch_ahead_icon": "\udb85\udcca ",
            "branch_behind_icon": "\udb85\udccb ",
            "branch_gone_icon": "\ueab8",
            "branch_icon": "\udb81\ude2c",
            "branch_identical_icon": "\udb85\udccf",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true
          },
          "leading_diamond": "<p:comment>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "template": "{{if .BranchStatus }} {{ .BranchStatus }}{{ end }} {{ .Ref }} ",
          "foreground": "p:currentLine",
          "background": "p:purple",
          "type": "git",
          "style": "diamond",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:green{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:green{{ end }}",
            "{{ if gt .Behind 0 }}p:orange{{ end }}"
          ]
        },
        {
          "properties": {
            "branch_gone_icon": "\ueab8",
            "branch_icon": "\uf418 ",
            "branch_identical_icon": "\uf444",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true
          },
          "trailing_diamond": "\ue0b0",
          "template": "{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "p:background",
          "background": "p:comment",
          "type": "git",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b2",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "p:cyan",
          "background": "p:background",
          "type": "session",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "❯ ",
          "foreground": "p:currentLine",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
